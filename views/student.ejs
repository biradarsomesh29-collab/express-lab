<!DOCTYPE html>
<html>
<head>
    <title>Student - Express.js Lab</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="container route-page">

        <div class="route-icon">🎓</div>

        <h1>Student Details</h1>

        <p class="subtitle">
