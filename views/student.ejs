            <h2><%= id %></h2>

        </div>

        <div class="section">

            <h2>🔗 Route Used</h2>

            <p>
                /student/<%= id %>
            </p>

        </div>

        <a href="/" class="back-btn">
            ← Back to File Upload
        </a>

        <div class="footer">
            Express.js • Routing & Route Parameters
        </div>

    </div>

</body>
</html>